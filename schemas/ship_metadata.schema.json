{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://void-shipwright.local/schemas/ship_metadata.schema.json",
  "title": "Void Shipwright Ship Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "ship_id",
    "role",
    "faction",
    "seed",
    "variant",
    "units",
    "source_axis",
    "godot_axis",
    "required_contract",
    "meshes",
    "sockets",
    "collision_proxies",
    "damage_zones",
    "vfx_markers",
    "camera_markers",
    "target_markers"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generator": {
      "type": "string",
      "const": "Void Shipwright"
    },
    "ship_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "role": {
      "type": "string",
      "enum": [
        "player",
        "enemy",
        "ally",
        "neutral",
        "civilian",
        "boss",
        "drone",
        "background_traffic"
      ]
    },
    "faction": {
      "type": "string",
      "enum": [
        "pirate_clan",
        "sector_navy",
        "trade_consortium",
        "mining_guild",
        "smuggler_network",
        "corporate_security",
        "ancient_relic",
        "independent"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "ship_frame": {
      "type": "string",
      "enum": [
        "light_raider",
        "interceptor",
        "gunship",
        "boarding_frigate",
        "missile_corvette",
        "freighter",
        "heavy_cruiser",
        "mining_ship",
        "salvage_ship",
        "medical_ship",
        "racing_ship",
        "luxury_yacht",
        "boss_capital_ship"
      ]
    },
    "ship_frame_definition": {
      "type": "object",
      "additionalProperties": true
    },
    "units": {
      "type": "string",
      "const": "meters"
    },
    "source_axis": {
      "$ref": "#/$defs/axis_map"
    },
    "godot_axis": {
      "$ref": "#/$defs/axis_map"
    },
    "required_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sockets", "damage_zones", "collision_proxies"],
      "properties": {
        "sockets": {
          "type": "array",
          "items": {"type": "string"}
        },
        "damage_zones": {
          "type": "array",
          "items": {"type": "string"}
        },
        "collision_proxies": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "meshes": {
      "type": "array",
      "items": {"$ref": "#/$defs/mesh_entry"}
    },
    "sockets": {
      "type": "array",
      "items": {"$ref": "#/$defs/socket_entry"}
    },
    "collision_proxies": {
      "type": "array",
      "items": {"$ref": "#/$defs/collision_entry"}
    },
    "damage_zones": {
      "type": "array",
      "items": {"$ref": "#/$defs/damage_entry"}
    },
    "vfx_markers": {
      "type": "array",
      "items": {"$ref": "#/$defs/vfx_entry"}
    },
    "camera_markers": {
      "type": "array",
      "items": {"$ref": "#/$defs/camera_entry"}
    },
    "target_markers": {
      "type": "array",
      "items": {"$ref": "#/$defs/target_entry"}
    },
    "hardpoints": {
      "type": "array",
      "items": {"$ref": "#/$defs/hardpoint_entry"}
    },
    "component_slots": {
      "type": "array",
      "items": {"$ref": "#/$defs/component_slot_entry"}
    },
    "equipment_recommendations": {
      "$ref": "#/$defs/equipment_recommendations"
    },
    "performance_baseline": {
      "$ref": "#/$defs/performance_baseline"
    },
    "subsystem_layout": {
      "type": "array",
      "items": {"$ref": "#/$defs/subsystem_entry"}
    }
  },
  "$defs": {
    "axis_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forward", "up", "right"],
      "properties": {
        "forward": {"type": "string"},
        "up": {"type": "string"},
        "right": {"type": "string"}
      }
    },
    "transform_entry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "position", "rotation_euler", "scale"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "position": {"$ref": "#/$defs/vector3"},
        "rotation_euler": {"$ref": "#/$defs/vector3"},
        "scale": {"$ref": "#/$defs/vector3"}
      }
    },
    "mesh_entry": {
      "allOf": [
        {"$ref": "#/$defs/transform_entry"},
        {
          "type": "object",
          "required": ["mesh_role"],
          "properties": {
            "name": {"pattern": "^MESH_"},
            "mesh_role": {"type": "string"}
          }
        }
      ]
    },
    "socket_entry": {
      "allOf": [
        {"$ref": "#/$defs/transform_entry"},
        {
          "type": "object",
          "required": ["socket_type"],
          "properties": {
            "name": {"pattern": "^SOCKET_"},
            "socket_type": {
              "type": "string",
              "enum": ["weapon", "missile", "engine", "camera", "target", "loot", "boarding", "hardpoint", "generic"]
            }
          }
        }
      ]
    },
    "collision_entry": {
      "allOf": [
        {"$ref": "#/$defs/transform_entry"},
        {
          "type": "object",
          "required": ["shape", "disabled_by_default"],
          "properties": {
            "name": {"pattern": "^COLLISION_"},
            "shape": {"type": "string", "enum": ["box"]},
            "size": {"$ref": "#/$defs/vector3"},
            "disabled_by_default": {"type": "boolean"}
          }
        }
      ]
    },
    "damage_entry": {
      "allOf": [
        {"$ref": "#/$defs/transform_entry"},
        {
          "type": "object",
          "required": ["zone"],
          "properties": {
            "name": {"pattern": "^DAMAGE_"},
            "zone": {"type": "string"},
            "subsystem": {"type": "string"},
            "damage_multiplier": {"type": "number"},
            "critical_threshold": {"type": "number"},
            "linked_hardpoints": {
              "type": "array",
              "items": {"type": "string"}
            },
            "linked_components": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      ]
    },
    "vfx_entry": {
      "allOf": [
        {"$ref": "#/$defs/transform_entry"},
        {
          "type": "object",
          "required": ["vfx_type"],
          "properties": {
            "name": {"pattern": "^VFX_"},
            "vfx_type": {"type": "string"}
          }
        }
      ]
    },
    "camera_entry": {
      "allOf": [
        {"$ref": "#/$defs/transform_entry"},
        {
          "type": "object",
          "required": ["camera_type"],
          "properties": {
            "name": {"pattern": "^CAMERA_"},
            "camera_type": {"type": "string"}
          }
        }
      ]
    },
    "target_entry": {
      "allOf": [
        {"$ref": "#/$defs/transform_entry"},
        {
          "type": "object",
          "required": ["target_type"],
          "properties": {
            "name": {"pattern": "^TARGET_"},
            "target_type": {"type": "string"}
          }
        }
      ]
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "hardpoint_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "size",
        "position",
        "rotation",
        "allowed_equipment_types",
        "allowed_mount_modes",
        "symmetry_group",
        "required",
        "optional",
        "visual_socket_name",
        "gameplay_socket_name"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "type": {
          "type": "string",
          "enum": [
            "weapon_fixed",
            "weapon_gimbal",
            "turret",
            "missile_rack",
            "torpedo_rack",
            "utility",
            "mining",
            "salvage",
            "tractor",
            "shield",
            "engine",
            "maneuver_thruster",
            "cargo",
            "boarding",
            "scanner",
            "countermeasure",
            "docking",
            "cosmetic"
          ]
        },
        "size": {"type": "integer", "minimum": 1, "maximum": 10},
        "position": {"$ref": "#/$defs/vector3"},
        "rotation": {"$ref": "#/$defs/vector3"},
        "allowed_equipment_types": {
          "type": "array",
          "items": {"type": "string"}
        },
        "allowed_mount_modes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "symmetry_group": {"type": "string"},
        "required": {"type": "boolean"},
        "optional": {"type": "boolean"},
        "visual_socket_name": {"type": "string", "pattern": "^SOCKET_HP_"},
        "gameplay_socket_name": {"type": "string", "pattern": "^SOCKET_"}
      }
    },
    "component_slot_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "slot_type", "size", "required", "optional", "role_tags"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "display_name": {"type": "string"},
        "slot_type": {
          "type": "string",
          "enum": [
            "power_plant",
            "cooler",
            "shield_generator",
            "quantum_or_warp_drive",
            "radar",
            "scanner",
            "life_support",
            "avionics",
            "armor_plating",
            "cargo_module",
            "crew_module",
            "repair_module",
            "stealth_module"
          ]
        },
        "size": {"type": "integer", "minimum": 1, "maximum": 10},
        "required": {"type": "boolean"},
        "optional": {"type": "boolean"},
        "role_tags": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "equipment_recommendations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loadout_id", "notes", "equipment", "components"],
      "properties": {
        "loadout_id": {"type": "string"},
        "notes": {"type": "string"},
        "equipment": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hardpoint", "equipment_id"],
            "properties": {
              "hardpoint": {"type": "string"},
              "equipment_id": {"type": "string"}
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "component_id"],
            "properties": {
              "slot": {"type": "string"},
              "component_id": {"type": "string"}
            }
          }
        }
      }
    },
    "performance_baseline": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "base_hull_hp": {"type": "number"},
        "base_shield_capacity": {"type": "number"},
        "mass": {"type": "number"},
        "cargo_capacity": {"type": "number"},
        "crew_capacity": {"type": "number"},
        "power_output": {"type": "number"},
        "heat_capacity": {"type": "number"},
        "cooling_capacity": {"type": "number"},
        "maneuverability": {"type": "number"},
        "max_speed": {"type": "number"},
        "boost_strength": {"type": "number"}
      }
    },
    "subsystem_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "subsystem", "damage_multiplier", "critical_threshold", "linked_hardpoints", "linked_components"],
      "properties": {
        "name": {"type": "string", "pattern": "^DAMAGE_"},
        "subsystem": {"type": "string"},
        "damage_multiplier": {"type": "number"},
        "critical_threshold": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "linked_hardpoints": {
          "type": "array",
          "items": {"type": "string"}
        },
        "linked_components": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
